{
  "name": "replynodes-mcp",
  "displayName": "Replynodes",
  "version": "0.1.3",
  "description": "Connect Claude to ReplyNodes' public, read-only data over MCP.",
  "author": {
    "name": "Replynodes",
    "url": "https://replynodes.com"
  },
  "homepage": "https://replynodes.com",
  "repository": "https://github.com/replynodes/replynodes-mcp",
  "license": "MIT",
  "keywords": ["mcp", "replynodes", "social-media", "ai-agent"],
  "mcpServers": {
    "replynodes": {
      "command": "npx",
      "args": ["-y", "@replynodes/mcp"],
      "env": {
        "REPLYNODES_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "ReplyNodes credential",
      "description": "Claim one at https://replynodes.com/auth.md",
      "sensitive": true,
      "required": true
    }
  }
}
