{
  "name": "replynodes-mcp",
  "displayName": "ReplyNodes",
  "version": "0.1.3",
  "description": "Connect Claude to ReplyNodes' public, read-only web data over MCP — web search, scraping, crawling, Reddit, YouTube, App Store, Google Play, Hacker News, and brand intelligence.",
  "author": {
    "name": "Replynodes",
    "url": "https://replynodes.com"
  },
  "homepage": "https://replynodes.com",
  "repository": "https://github.com/replynodes/replynodes-mcp",
  "license": "MIT",
  "keywords": ["mcp", "replynodes", "web-search", "web-scraping", "reddit", "youtube", "app-store", "google-play", "hacker-news", "brand-intelligence", "ai-agent", "read-only"],
  "mcpServers": {
    "replynodes": {
      "command": "npx",
      "args": ["-y", "@replynodes/mcp"],
      "env": {
        "REPLYNODES_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "ReplyNodes credential",
      "description": "Claim one at https://replynodes.com/auth.md",
      "sensitive": true,
      "required": true
    }
  }
}
