{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.replynodes/mcp",
  "description": "Read-only MCP server for AI agents that provides Web Search, Web Scraping, Website Crawling, Reddit, YouTube, App Store, Google Play, Hacker News, and Brand Intelligence through one MCP endpoint.",
  "repository": {
    "url": "https://github.com/replynodes/replynodes-mcp",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@replynodes/mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "ReplyNodes credential claimed through https://replynodes.com/auth.md",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "REPLYNODES_API_KEY"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.replynodes.com/mcp"
    }
  ]
}
